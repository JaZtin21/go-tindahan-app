# ============================================================================
# RESTAURANT BOOKING SYSTEM — GraphQL Schema
# Mirrors your existing auth schema conventions: types, inputs, and
# `extend type Query/Mutation` blocks grouped per feature.
# ============================================================================

# ----------------------------------------------------------------------------
# ENUMS
# ----------------------------------------------------------------------------

enum SeatingType {
  STANDARD       # casual, walk-in-friendly, turn-based tables
  FIXED_SITTING  # fine dining, fixed seating times (e.g. 6pm / 8:30pm)
}

enum RestaurantUserRole {
  OWNER
  MANAGER
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  NONE
  PENDING
  PAID
  REFUNDED
}

enum BookingSource {
  PHONE
  WEB
  WALK_IN
  THIRD_PARTY
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CONVERTED
  EXPIRED
}

enum CallOutcome {
  BOOKED
  NO_AVAILABILITY
  TRANSFERRED
  ABANDONED
}

# ----------------------------------------------------------------------------
# CORE TYPES
# ----------------------------------------------------------------------------

type Restaurant {
  id: String!
  name: String!
  phone: String!
  email: String
  addressLine1: String!
  suburb: String!
  state: String!
  postcode: String!
  timezone: String!
  cuisineType: String
  seatingType: SeatingType!
  defaultTurnDurationMin: Int!
  bookingBufferMin: Int!
  maxPartySize: Int!
  description: String
  parkingInfo: String
  isActive: Boolean!
  tables: [RestaurantTable!]!
  operatingHours: [OperatingHours!]!
  closures: [Closure!]!
  createdAt: String!
  updatedAt: String!
}

type RestaurantUser {
  id: String!
  restaurantId: String!
  name: String!
  email: String!
  phone: String
  role: RestaurantUserRole!
  createdAt: String!
}

type RestaurantTable {
  id: String!
  restaurantId: String!
  tableNumber: String!
  capacityMin: Int!
  capacityMax: Int!
  section: String
  isActive: Boolean!
}

type OperatingHours {
  id: String!
  dayOfWeek: Int!       # 0 = Sunday
  openTime: String
  closeTime: String
  isClosed: Boolean!
}

type Closure {
  id: String!
  closureDate: String!
  reason: String
}

type Customer {
  id: String!
  phone: String!
  name: String
  email: String
  createdAt: String!
}

type Booking {
  id: String!
  restaurantId: String!
  customerId: String!
  customer: Customer
  tableId: String
  partySize: Int!
  bookingTime: String!
  durationMinutes: Int!
  status: BookingStatus!
  specialRequests: String
  paymentStatus: PaymentStatus!
  source: BookingSource!
  createdAt: String!
  updatedAt: String!
}

type WaitlistEntry {
  id: String!
  restaurantId: String!
  customerId: String!
  partySize: Int!
  requestedTime: String!
  status: WaitlistStatus!
  createdAt: String!
}

type CallLog {
  id: String!
  restaurantId: String
  vapiCallId: String!
  customerPhone: String
  customerName: String
  bookingId: String
  transcript: String
  outcome: CallOutcome
  createdAt: String!
}

# Used by the voice agent to check open tables for a given time/party size
type AvailableSlot {
  table: RestaurantTable!
  startTime: String!
  endTime: String!
}

# ----------------------------------------------------------------------------
# RESTAURANT — inputs & mutations
# ----------------------------------------------------------------------------

input CreateRestaurantInput {
  name: String!
  phone: String!
  email: String
  addressLine1: String!
  suburb: String!
  state: String!
  postcode: String!
  timezone: String
  cuisineType: String
  seatingType: SeatingType
  defaultTurnDurationMin: Int
  bookingBufferMin: Int
  maxPartySize: Int
}

input UpdateRestaurantInput {
  name: String
  phone: String
  email: String
  addressLine1: String
  suburb: String
  state: String
  postcode: String
  cuisineType: String
  seatingType: SeatingType
  defaultTurnDurationMin: Int
  bookingBufferMin: Int
  maxPartySize: Int
  description: String
  parkingInfo: String
  isActive: Boolean
}

# Public (no auth): restaurant discovery for customers/Vapi
# Private (@isAuthenticated): staff-only floor management
extend type Query {
  restaurant(id: String!): Restaurant
  restaurants(suburb: String, cuisineType: String): [Restaurant!]!
  tables(restaurantId: String!): [RestaurantTable!]! @isAuthenticated
}

extend type Mutation {
  createRestaurant(input: CreateRestaurantInput!): Restaurant! @isAuthenticated
  updateRestaurant(id: String!, input: UpdateRestaurantInput!): Restaurant! @isAuthenticated
}

# ----------------------------------------------------------------------------
# MENU — inputs & mutations (staff-edited, read aloud by the voice agent)
# ----------------------------------------------------------------------------

type MenuItem {
  id: String!
  restaurantId: String!
  name: String!
  description: String
  priceCents: Int!
  category: String
  isAvailable: Boolean!
  allergens: [String!]!
  sortOrder: Int!
}

input CreateMenuItemInput {
  restaurantId: String!
  name: String!
  description: String
  priceCents: Int!
  category: String
  allergens: [String!]
}

input UpdateMenuItemInput {
  name: String
  description: String
  priceCents: Int
  category: String
  isAvailable: Boolean
  allergens: [String!]
  sortOrder: Int
}

extend type Query {
  menuItems(restaurantId: String!): [MenuItem!]! @isAuthenticated
}

extend type Mutation {
  createMenuItem(input: CreateMenuItemInput!): MenuItem! @isAuthenticated
  updateMenuItem(id: String!, input: UpdateMenuItemInput!): MenuItem! @isAuthenticated
  deleteMenuItem(id: String!): Boolean! @isAuthenticated
}

# ----------------------------------------------------------------------------
# TABLES — inputs & mutations
# ----------------------------------------------------------------------------

input CreateTableInput {
  restaurantId: String!
  tableNumber: String!
  capacityMin: Int!
  capacityMax: Int!
  section: String
}

input UpdateTableInput {
  tableNumber: String
  capacityMin: Int
  capacityMax: Int
  section: String
  isActive: Boolean
}

extend type Mutation {
  createTable(input: CreateTableInput!): RestaurantTable! @isAuthenticated
  updateTable(id: String!, input: UpdateTableInput!): RestaurantTable! @isAuthenticated
  deleteTable(id: String!): Boolean! @isAuthenticated
}

# ----------------------------------------------------------------------------
# OPERATING HOURS & CLOSURES — inputs & mutations
# ----------------------------------------------------------------------------

input SetOperatingHoursInput {
  dayOfWeek: Int!
  openTime: String
  closeTime: String
  isClosed: Boolean
}

input CreateClosureInput {
  restaurantId: String!
  closureDate: String!
  reason: String
}

extend type Mutation {
  setOperatingHours(restaurantId: String!, hours: [SetOperatingHoursInput!]!): [OperatingHours!]! @isAuthenticated
  createClosure(input: CreateClosureInput!): Closure! @isAuthenticated
  deleteClosure(id: String!): Boolean! @isAuthenticated
}

extend type Query {
  operatingHours(restaurantId: String!): [OperatingHours!]! @isAuthenticated
  closures(restaurantId: String!): [Closure!]! @isAuthenticated
}

# ----------------------------------------------------------------------------
# CUSTOMERS — inputs & mutations
# ----------------------------------------------------------------------------

input FindOrCreateCustomerInput {
  phone: String!
  name: String
  email: String
}

extend type Query {
  # Private: staff-only customer lookup
  customer(phone: String!): Customer @isAuthenticated
}

extend type Mutation {
  # Public: used by the voice agent / customer flow — look up by phone, create if new
  findOrCreateCustomer(input: FindOrCreateCustomerInput!): Customer!
}

# ----------------------------------------------------------------------------
# BOOKINGS — inputs, queries & mutations
# ----------------------------------------------------------------------------

input CheckAvailabilityInput {
  restaurantId: String!
  partySize: Int!
  requestedTime: String!   # ISO 8601
}

input CreateBookingInput {
  restaurantId: String!
  customerId: String!
  tableId: String            # optional — can be assigned later
  partySize: Int!
  bookingTime: String!       # ISO 8601
  specialRequests: String
  source: BookingSource
  idempotencyKey: String!    # required — prevents duplicate bookings on retry
}

input UpdateBookingInput {
  tableId: String
  partySize: Int
  bookingTime: String
  status: BookingStatus
  specialRequests: String
  paymentStatus: PaymentStatus
}

extend type Query {
  booking(id: String!): Booking @isAuthenticated
  bookings(restaurantId: String!, date: String, status: BookingStatus): [Booking!]! @isAuthenticated
  # Public: customers/Vapi check open tables without a session
  checkAvailability(input: CheckAvailabilityInput!): [AvailableSlot!]!
}

extend type Mutation {
  # Public: website customers & Vapi create bookings without a session
  createBooking(input: CreateBookingInput!): Booking!
  updateBooking(id: String!, input: UpdateBookingInput!): Booking! @isAuthenticated
  cancelBooking(id: String!): Booking! @isAuthenticated
  assignTable(bookingId: String!, tableId: String!): Booking! @isAuthenticated
}

# ----------------------------------------------------------------------------
# WAITLIST — inputs & mutations
# ----------------------------------------------------------------------------

input CreateWaitlistEntryInput {
  restaurantId: String!
  customerId: String!
  partySize: Int!
  requestedTime: String!
}

extend type Query {
  waitlist(restaurantId: String!, status: WaitlistStatus): [WaitlistEntry!]! @isAuthenticated
}

extend type Query {
  callLogs(restaurantId: String!): [CallLog!]! @isAuthenticated
  callLog(vapiCallId: String!): CallLog @isAuthenticated
}

# ----------------------------------------------------------------------------
# WAITLIST — mutations
# ----------------------------------------------------------------------------

extend type Mutation {
  # Public: Vapi adds a caller to the overflow queue when the restaurant is full
  createWaitlistEntry(input: CreateWaitlistEntryInput!): WaitlistEntry!
  updateWaitlistStatus(id: String!, status: WaitlistStatus!): WaitlistEntry! @isAuthenticated
  convertWaitlistToBooking(id: String!, tableId: String!): Booking! @isAuthenticated
}